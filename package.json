{
  "name": "pos-frontend",
  "version": "1.0.0",
  "description": "سیستەمی پێشکەوتووی مارکێت و فرۆشتن",
  "author": "Arsh",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "start:backend": "cd backend && npm start",
    "start:frontend": "npm run dev",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "dist:win": "vite build && electron-builder --win",
    "pack": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.marketpos.app",
    "productName": "MarketPOS",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "backend/**/*"
    ],
    "files": [
      "dist/**/*",
      "backend/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "سیستەمی مارکێت POS",
      "runAfterFinish": true,
      "artifactName": "MarketPOS_Setup.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
